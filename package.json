{
  "name": "braintrust",
  "version": "1.0.0",
  "private": true,
  "description": "A living council of the minds you follow. Nothing here ships on npm \u2014 braintrust is a repo you clone, configure and deploy.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --project tsconfig.test.json",
    "start": "node dist/server/index.js",
    "job": "node dist/job/index.js",
    "eval": "node dist/eval/index.js",
    "calibrate": "node dist/calibrate/index.js",
    "qa": "node dist/qa/index.js",
    "dev": "tsx watch src/server/index.ts",
    "job:dev": "tsx src/job/index.ts",
    "eval:dev": "tsx src/eval/index.ts",
    "calibrate:dev": "tsx src/calibrate/index.ts",
    "qa:dev": "tsx src/qa/index.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --import tsx --test --test-concurrency=1 \"test/!(*.integration).test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"test/*.integration.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
