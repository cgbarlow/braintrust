# braintrust configuration.
#
# Copy to .env and fill in. braintrust reads eight environment variables: six
# required settings it refuses to start without (reporting all of them at once,
# rather than one restart at a time), plus the issue-tracker pair below that is
# required together or not at all — and its absence is loud, never silent.
# See docs/design/deployment.md §3.
#
# Both deployments read the same file: the always-on web service, and the
# scheduled job that wakes daily.

# --- Required -------------------------------------------------------------

# Postgres. Use Supabase's SESSION pooler (port 5432), not the transaction
# pooler (6543) and not the direct host. braintrust connects directly rather
# than through PostgREST, because promoting a compile is a multi-statement
# transaction and PostgREST has none.
BRAINTRUST_DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# The shared secret your AI clients present as ?key=<secret>. Guards the read
# path only; the scheduled job never touches the MCP surface.
BRAINTRUST_MCP_KEY=change-me

# An OpenAI-compatible /v1/embeddings endpoint. Ollama, LM Studio, vLLM and
# OpenAI all speak it, so local versus hosted is this line rather than a design
# decision.
#
# THERE IS NO DEFAULT, EVER. A default would mean a first run silently shipping
# someone's entire published corpus to a third party.
#
# The reference configuration is qwen3-embedding:0.6b at 1024 dimensions, which
# is what schema.sql's vector(1024) is sized for. Change both together — both
# deployments embed a probe string at startup and compare its width to the
# column, so a mismatch is one message rather than a silently poisoned index.
# Local Ollama:  http://localhost:11434/v1
# Hosted:        https://api.openai.com/v1
BRAINTRUST_EMBEDDINGS_BASE_URL=http://localhost:11434/v1
BRAINTRUST_EMBEDDINGS_MODEL=qwen3-embedding:0.6b

# The note extractor: the one genuinely expensive job in braintrust. It reads
# each item exactly once and writes down the claims, the argument and the
# assumptions; every later rebuild reads those notes rather than 1.17M words.
# Standing a corpus up costs a few dollars here and about three cents
# everywhere else.
#
# Any OpenAI-compatible /v1/chat/completions endpoint. No default: it is handed
# whole published items, and where those go is yours to decide. Required, and
# for a different reason than the embeddings endpoint — without it the daily
# job runs green forever and no persona is ever compiled.
#
# Changing the model changes the note generation, which re-reads the corpus
# alongside the old notes rather than migrating them. The persona built from
# the old generation stays live while that happens.
BRAINTRUST_EXTRACTOR_BASE_URL=https://api.openai.com/v1
BRAINTRUST_EXTRACTOR_MODEL=gpt-5

# --- Optional -------------------------------------------------------------

# Only needed for a hosted embeddings endpoint. Local runtimes ignore it.
# BRAINTRUST_EMBEDDINGS_API_KEY=

# Needed for any hosted extractor, which is most of them.
# BRAINTRUST_EXTRACTOR_API_KEY=

# Port the web service listens on. Defaults to 3000; most container platforms
# set this for you.
# PORT=3000

# Where braintrust files a fault only a person can clear.
#
# braintrust interrogates itself weekly, and on every compiler change, about the
# guarantee the whole design rests on: that a persona with no way to look anything
# up cannot produce that person's distinctive claims. A failure does not withdraw
# the persona and does not warn the reader — it opens one deduplicated issue on
# the repo below, because a fault in the compiler is a fault only a code change
# clears, and the maintainer is the only audience that can clear it.
#
# Both or neither: a repo with no token cannot file, and a token with no repo has
# nowhere to file to. Unconfigured is allowed and is NOT quiet — a run without
# this pair announces at startup that nothing it finds tonight can reach anybody,
# and once a fault is found unconfigured the whole issue is printed to the job
# log on every run until a tracker is set or the assertion passes. The token
# needs `issues: write` on that repo and nothing else. The job host's .env must
# carry the pair too — that omission is how faults silently went nowhere.
#
# BRAINTRUST_ISSUES_REPO=owner/repo
# BRAINTRUST_ISSUES_TOKEN=

# Optional, and normally absent. braintrust measures its own retrieval floor per person on
# every compile, so there is nothing to set here — this only exists to overrule that
# measurement, and setting it makes one number apply to every persona.
#
# BRAINTRUST_RETRIEVAL_FLOOR=0.5
#
# BRAINTRUST_SELECTIVITY_MARGIN is its retired predecessor and is read by nothing. If your
# deployment still carries one, it is inert: delete it whenever convenient, or leave it.
